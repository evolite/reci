// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?   // Null for accounts that only sign in through authentik
  oidcSub               String?   @unique // authentik subject claim
  name                  String?
  isAdmin               Boolean   @default(false)
  emailVerified         Boolean   @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  recipes               Recipe[]
  shoppingCart          ShoppingCart?
  recipeRatings         RecipeRating[]

  @@map("users")
}


model Recipe {
  id              String   @id @default(uuid())
  videoUrl        String   @unique
  videoPlatform   String?  // Optional platform identifier (e.g., "youtube", "instagram", "tiktok")
  thumbnailUrl    String
  imagePath       String?  // Locally stored copy of the thumbnail (e.g. "/images/<id>.jpg"); external CDN URLs expire
  description     String   @default("")
  dishName        String
  cuisineType     String
  ingredients     String @default("[]") // Full ingredients list with amounts (e.g., "2 dl milk", "500 g flour") — JSON array stored as text
  tags            String @default("[]") // User-added tags — JSON array stored as text
  instructions    String?  // Recipe instructions/steps (without ingredients)
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id])
  ratings         RecipeRating[]

  @@index([dishName])
  @@index([cuisineType])
  @@map("recipes")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waitlist")
}

model ShoppingCart {
  id            String   @id @default(uuid())
  userId        String   @unique
  recipeIds     String @default("[]") // JSON array stored as text
  shoppingList  Json     // ShoppingListResponse structure
  checkedItems  String @default("[]") // JSON array stored as text
  shareToken    String?  @unique // UUID for sharing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareToken])
  @@map("shopping_carts")
}

model Setting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model RecipeRating {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  rating    Int      // 1-6 dice rating
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([recipeId])
  @@index([userId])
  @@map("recipe_ratings")
}
